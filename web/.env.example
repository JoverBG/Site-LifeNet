# Onde o servidor Next busca os dados do admin PHP (api/site.php). Na VM 104
# usa o server block HTTP interno pra não sair pela internet e voltar (hairpin).
SITE_API_URL=http://10.20.2.11/api

# Prefixo das chamadas feitas NO NAVEGADOR (services_status, track, logs).
# Em produção fica vazio (= mesma origem, o nginx roteia /api pro PHP).
# No dev local aponta pra produção: NEXT_PUBLIC_PHP_BASE=https://lifenett.com.br
NEXT_PUBLIC_PHP_BASE=
